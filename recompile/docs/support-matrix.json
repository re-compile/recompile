{
  "schema_version": "1.0",
  "purpose": "phase5_support_matrix",
  "scope": "Linux-native C/C++ runtime observability for user-built ELF binaries",
  "status_values": [
    "supported",
    "instrumented_binary_supported",
    "observed_only",
    "unsupported",
    "not_applicable",
    "planned",
    "not_covered"
