  "classes": [
    {
      "class": "heap_overflow",
      "category": "memory_safety",
      "native": {
        "status": "supported",
        "evidence": "allocator metadata plus bounded libc copy/string operation probes",
        "positive_cases": [
          "copy_overrun_case",
          "memmove_overrun_case",
          "memset_overrun_case",
          "strcpy_overrun_case",
          "strncpy_overrun_case",
          "multi_overrun_case",
          "posix_memalign_overrun_case",
          "aligned_alloc_overrun_case",
          "strdup_overrun_case",
          "multifile-heap",
          "args-cwd",
          "multi-binary-worker",
          "shared-lib"
        ],
        "clean_negative_cases": [
          "clean_bounded_memcpy",
          "clean_bounded_memmove",
          "clean_bounded_memset",
          "clean_bounded_strcpy",
          "clean_bounded_strncpy",
          "clean_malloc_free",
          "clean-multifile",
          "multi-binary-healthcheck"
        ]
      },
      "tools": {
        "valgrind": "supported",
        "asan": "instrumented_binary_supported",
        "lsan": "not_applicable",
        "ubsan": "not_applicable"
      },
      "limitations": [
        "Native support currently depends on observed libc allocation and copy/string APIs.",
        "Arbitrary handwritten pointer arithmetic is not classified unless it reaches a probed operation or a tool confirms it."
      ]
    },
    {
