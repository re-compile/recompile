{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "re:compile Repeat Observation Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "output_root",
    "requested_attempts",
    "completed_attempts",
    "status_totals",
    "outcome_totals",
    "finding_totals_by_class",
    "first_failure",
    "best_evidence_attempt",
    "escalation_policy",
    "issue_groups",
    "attempts",
    "next_commands"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "purpose": {"const": "repeat_observation_summary"},
    "output_root": {"type": "string"},
    "requested_attempts": {"type": "integer", "minimum": 1},
    "completed_attempts": {"type": "integer", "minimum": 0},
    "status_totals": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "outcome_totals": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "finding_totals_by_class": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "first_failure": {"anyOf": [{"$ref": "#/$defs/selection"}, {"type": "null"}]},
    "best_evidence_attempt": {"anyOf": [{"$ref": "#/$defs/selection"}, {"type": "null"}]},
    "escalation_policy": {"$ref": "#/$defs/escalation_policy"},
    "issue_groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/repeat_issue_group"}
    },
    "attempts": {
      "type": "array",
      "items": {"$ref": "#/$defs/attempt"}
    },
    "next_commands": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "clean",
        "findings",
        "failed",
        "timeout",
        "skipped",
        "tool_unavailable",
        "not_applicable"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "pass",
        "finding",
        "failure",
        "timeout",
        "inconclusive"
      ]
    },
    "class_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "target_name",
        "status",
        "outcome",
        "reason",
        "run_summary",
        "crashpack",
        "findings_count",
        "findings_by_class"
      ],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "target_name": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "outcome": {"$ref": "#/$defs/outcome"},
        "reason": {"type": "string", "minLength": 1},
        "run_summary": {"type": "string"},
        "crashpack": {"type": "string"},
        "findings_count": {"type": "integer", "minimum": 0},
        "findings_by_class": {"$ref": "#/$defs/class_counts"}
      }
    },
    "escalation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "deep",
        "selected_attempt_count",
        "selected_attempts"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": ["never", "first-failure", "sampled", "always"]
        },
        "deep": {"type": "boolean"},
        "selected_attempt_count": {"type": "integer", "minimum": 0},
        "selected_attempts": {
          "type": "array",
          "items": {"$ref": "#/$defs/escalation_attempt"}
        }
      }
    },
    "escalation_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "target_name",
        "status",
        "outcome",
        "reason",
        "run_summary",
        "crashpack",
        "findings_count",
        "findings_by_class"
      ],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "target_name": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "outcome": {"$ref": "#/$defs/outcome"},
        "reason": {"type": "string", "minLength": 1},
        "run_summary": {"type": "string"},
        "crashpack": {"type": "string"},
        "findings_count": {"type": "integer", "minimum": 0},
        "findings_by_class": {"$ref": "#/$defs/class_counts"}
      }
    },
    "repeat_issue_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "class",
        "operation",
        "severity",
        "confidence",
        "attempt_count",
        "occurrence_count",
        "first_attempt",
        "last_attempt",
        "representative_attempt",
        "attempts"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "minLength": 1},
        "class": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "minLength": 1},
        "confidence": {"type": "string", "minLength": 1},
        "attempt_count": {"type": "integer", "minimum": 1},
        "occurrence_count": {"type": "integer", "minimum": 1},
        "first_attempt": {"type": "integer", "minimum": 1},
        "last_attempt": {"type": "integer", "minimum": 1},
        "representative_attempt": {"$ref": "#/$defs/repeat_issue_group_occurrence"},
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/repeat_issue_group_occurrence"}
        }
      }
    },
    "repeat_issue_group_occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "target_name",
        "issue_group_id",
        "finding_count",
        "issue_groups",
        "crashpack"
      ],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "target_name": {"type": "string", "minLength": 1},
        "issue_group_id": {"type": "string", "minLength": 1},
        "finding_count": {"type": "integer", "minimum": 1},
        "issue_groups": {"type": "string", "minLength": 1},
        "crashpack": {"type": "string", "minLength": 1}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "target_name",
        "status",
        "outcome",
        "output_root",
        "run_summary",
        "crashpack",
        "findings",
        "evidence_pack",
        "issue_groups",
        "findings_count",
        "findings_by_class",
        "issue_group_count",
        "error",
        "duration_ms",
        "next_commands"
      ],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "target_name": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "outcome": {"$ref": "#/$defs/outcome"},
        "output_root": {"type": "string"},
        "run_summary": {"type": "string"},
        "crashpack": {"type": "string"},
        "findings": {"type": "string"},
        "evidence_pack": {"type": "string"},
        "issue_groups": {"type": ["string", "null"]},
        "findings_count": {"type": "integer", "minimum": 0},
        "findings_by_class": {"$ref": "#/$defs/class_counts"},
        "issue_group_count": {"type": "integer", "minimum": 0},
        "error": {"type": ["string", "null"]},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "next_commands": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
