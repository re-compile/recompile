{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "re:compile Observation Run Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "output_root",
    "target_count",
    "status_totals",
    "finding_totals_by_class",
    "escalation_totals_by_tool",
    "targets",
    "next_commands"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "purpose": {"const": "local_runtime_observation"},
    "output_root": {"type": "string"},
    "target_count": {"type": "integer", "minimum": 0},
    "status_totals": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "finding_totals_by_class": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "escalation_totals_by_tool": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "integer", "minimum": 0}
      }
    },
    "targets": {
      "type": "array",
      "items": {"$ref": "#/$defs/target"}
    },
    "next_commands": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "clean",
        "findings",
        "failed",
        "timeout",
        "skipped",
        "tool_unavailable",
        "not_applicable"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "binary_path",
        "args",
        "cwd",
        "env",
        "status",
        "error",
        "exit",
        "duration_ms",
        "timeout_ms",
        "findings_count",
        "findings_by_class",
        "issue_group_count",
        "escalation",
        "diagnostics",
        "artifacts",
        "replay_command",
        "summarize_command",
        "next_commands"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "binary_path": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string", "minLength": 1},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "status": {"$ref": "#/$defs/status"},
        "error": {"type": ["string", "null"]},
        "exit": {"$ref": "#/$defs/exit"},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "timeout_ms": {"type": ["integer", "null"], "minimum": 0},
        "findings_count": {"type": "integer", "minimum": 0},
        "findings_by_class": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "issue_group_count": {"type": "integer", "minimum": 0},
        "escalation": {"type": "array", "items": {"$ref": "#/$defs/escalation"}},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "artifacts": {"$ref": "#/$defs/artifacts"},
        "replay_command": {"type": ["string", "null"]},
        "summarize_command": {"type": ["string", "null"]},
        "next_commands": {"type": "array", "items": {"type": "string"}}
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "signal", "crashed"],
      "properties": {
        "code": {"type": ["integer", "null"]},
        "signal": {"type": ["integer", "null"]},
        "crashed": {"type": "boolean"}
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "status", "confirmed", "findings_detected", "artifact_path", "error", "duration_ms", "timeout_ms"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "confirmed": {"type": "boolean"},
        "findings_detected": {"type": "array", "items": {"type": "string"}},
        "artifact_path": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "timeout_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "status", "detail", "remediation"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["ok", "warning", "missing", "unavailable", "unsupported"]
        },
        "detail": {"type": "string", "minLength": 1},
        "remediation": {"type": ["string", "null"]}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crashpack",
        "evidence_pack",
        "findings",
        "analysis",
        "manifest",
        "logs",
        "dependencies",
        "issue_groups"
      ],
      "properties": {
        "crashpack": {"type": "string"},
        "evidence_pack": {"type": "string"},
        "findings": {"type": "string"},
        "analysis": {"type": "string"},
        "manifest": {"type": "string"},
        "logs": {"type": "string"},
        "dependencies": {"type": ["string", "null"]},
        "issue_groups": {"type": ["string", "null"]}
      }
    }
  }
}
