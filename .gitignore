# OS / Editor
.DS_Store
.idea/
.vscode/
*.code-workspace

# Rust
/target/
**/target/

# Generic build dirs
/build/
**/build/

# Project-specific build outputs
recompile/build/
recompile/build/**

# QEMU/VM artifacts (keep cloud images for development)
recompile/runtime/vm/*.img
recompile/runtime/vm/*.qcow2
recompile/runtime/vm/*.iso
recompile/runtime/vm/uefi_vars.fd
recompile/runtime/vm/firmware.path
recompile/runtime/vm/seed.iso
recompile/runtime/vm/seed/
recompile/runtime/vm/kernel/vmlinuz
recompile/runtime/vm/kernel/initrd
# But keep the cloud-init user-data for development
!recompile/runtime/vm/user-data

# Findings and logs (keep for development)
recompile/build/re-findings.log
recompile/build/.re/

# eBPF build artifacts
recompile/runtime/bpf/*.o
recompile/runtime/bpf/*.bpf.o
recompile/runtime/bpf/*.ll
recompile/runtime/bpf/*.bc
recompile/runtime/bpf/*.skel.h
# Generated per-guest kernel header (large)
recompile/runtime/bpf/vmlinux.h

# CMake outputs
**/CMakeFiles/
**/CMakeCache.txt
**/cmake-build*/
**/install_manifest.txt

# Tools downloaded locally
cloud-localds

# Misc logs
*.log

# Keep important development files
!recompile/examples/
!recompile/scripts/
!recompile/runtime/agent/
!recompile/runtime/agent-rs/
!recompile/runtime/bpf/*.c
!recompile/runtime/bpf/*.h
!recompile/runtime/shared/
!recompile/runtime/vm/README.md
!recompile/runtime/vm/user-data
!recompile/runtime/vm/meta-data

# Exclude compiled binaries and debug symbols from examples
recompile/examples/*.dSYM/
recompile/examples/*.dSYM/**
recompile/examples/build/
recompile/examples/build/**
recompile/examples/double_free
recompile/examples/invalid_free
recompile/examples/memcpy_overflow
# But keep source files and build scripts
!recompile/examples/*.c
!recompile/examples/*.sh
!recompile/examples/*.toml
!recompile/examples/re.toml

# Keep documentation and planning files
!*.md
!plan.md
!v1-questions.md
!recompile/ARCHITECTURE.md
!recompile/README.md
!recompile/QUICKSTART.md
!recompile/CHANGELOG.md

# Keep configuration files
!recompile/re.toml
!recompile/Cargo.toml
!recompile/Cargo.lock
!recompile/Makefile

# Keep source code
!recompile/*/src/
!recompile/*/Cargo.toml

**/vmlinux.h
